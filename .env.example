# Sobhagya API gateway. Services are reached at /auth, /puja and /calling under it.
VITE_API_URL=https://micro.sobhagya.in

# Local development without the gateway: point at each service directly.
# VITE_AUTH_API_URL=http://localhost:4004
# VITE_PUJA_API_URL=http://localhost:11001
# VITE_CALLING_API_URL=http://localhost:5001

# Shows /dev/launch (stands in for the Sobhagya app). Off unless set to true, also with `pnpm dev`.
# VITE_ENABLE_DEV_LAUNCHER=false
